# 凭证与环境变量模板（只有键名，不得填写真实值）
# 真实值保存在仓库外的本地文件里，代码只从环境变量读取。

# 微信客服凭证文件的路径（文件在仓库外，JSON 格式）——本地读法
KF_SECRETS_FILE=

# 微信客服凭证五项（值直接给，云函数用；与 KF_SECRETS_FILE 二选一，
# 五项任一有值就走本组，缺项报错会点名缺哪个）
KF_CORP_ID=
KF_AGENT_ID=
KF_APP_SECRET=
KF_TOKEN=
KF_ENCODING_AES_KEY=

# 本地数据目录（相对 server/）
KF_DATA_DIR=

# 资源落盘目录（相对 server/）
KF_ASSETS_DIR=

# 输出目录（相对 server/）
KF_OUT_DIR=

# 阶段一接云：Cloudflare R2 对象存储（凭证实值只放本地/云环境变量）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
